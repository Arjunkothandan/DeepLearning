import tensorflow as tf
import matplotlib.pyplot as plt

path = "sm.jpeg"
img = tf.keras.utils.load_img(path, target_size=(224,224))
x = tf.keras.utils.img_to_array(img)
plt.imshow(img)
plt.axis("off")
plt.show()

models = [
    ("VGG16", tf.keras.applications.VGG16,
     tf.keras.applications.vgg16.preprocess_input),
    ("ResNet50", tf.keras.applications.ResNet50,
     tf.keras.applications.resnet50.preprocess_input),
    ("GoogleNet", tf.keras.applications.InceptionV3,
     tf.keras.applications.inception_v3.preprocess_input)
]

for name, create_model, preprocess in models:
    size = (299, 299) if name == "GoogleNet" else (224, 224)
    image = tf.keras.utils.load_img(path, target_size=size)
    arr = tf.keras.utils.img_to_array(image)
    arr = preprocess(arr[None, ...])
    model = create_model(weights = "imagenet")
    result = model.predict(arr, verbose=0)
    print("\\n", name)
    print(tf.keras.applications.imagenet_utils.decode_predictions(result, top=3)[0])
